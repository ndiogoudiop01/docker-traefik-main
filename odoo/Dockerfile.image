# ============================================================
# Dockerfile for Official Odoo Docker Image Deployment
# ============================================================
# This Dockerfile uses the official Odoo images from Docker Hub
# Recommended for: Production environments, stable releases
# Usage: Set DEPLOYMENT_MODE=image in .env file
# ============================================================

ARG ODOO_VERSION=19.0
FROM odoo:${ODOO_VERSION}

# Change to root user for installations
USER root

# Install system dependencies for xmlsec and git
# Ensure apt lists are clean before update
RUN rm -rf /var/lib/apt/lists/* && apt-get clean && apt-get update && \
    apt-get install -y --no-install-recommends \
    pkg-config \
    libxml2-dev \
    libxmlsec1-dev \
    libxmlsec1-openssl \
    git \
    gcc \
    python3-dev \
    python3-pip \
    nano \
    iputils-ping \
 && rm -rf /var/lib/apt/lists/*

# Install compatible lxml version for xmlsec 1.3.14
RUN pip3 install --break-system-packages lxml==5.1.0

# Install required xmlsec version
RUN pip3 install --break-system-packages xmlsec==1.3.14

# Install Peruvian Localization dependencies
RUN pip3 install --break-system-packages git+https://github.com/GrupoYACCK/pysimplesoap.git@sunat && \
    pip3 install --break-system-packages git+https://github.com/GrupoYACCK/librecpe.git@1.0.13 && \
    pip3 install --break-system-packages openpyxl odoo-test-helper openupgradelib && \
    pip3 install --break-system-packages git+https://github.com/GrupoYACCK/pyCFE.git@0.4.6 && \
    pip3 install --break-system-packages pdf2image && \
    pip3 install --break-system-packages paramiko && \
    pip3 install --break-system-packages qrcode==6.1 pdf417gen==0.7.1

# Set proper permissions for config
# NOTE: We do NOT override the entrypoint here to keep official image compatibility
RUN chown odoo:odoo /etc/odoo/odoo.conf

# Switch back to odoo user
USER odoo
